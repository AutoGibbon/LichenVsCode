	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#49433e" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace", "keyword.operator"],
			"settings": { "foreground": "#6b645b" }
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.word",
				"keyword.operator.logical.python",
				"variable.language"
			],
			"settings": { "foreground": "#398d6e" }
		},
		{
			"name": "String",
			"scope": ["string", "punctuation.definition.string", "markup.inline.raw"],
			"settings": { "foreground": "#b8616f" }
		},
		{
			"name": "String escape and regex",
			"scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
			"settings": { "foreground": "#6e8343" }
		},
		{
			"name": "Number and constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"support.constant",
				"keyword.other.unit",
				"constant.other.color"
			],
			"settings": { "foreground": "#b4763f" }
		},
		{
			"name": "Function declaration",
			"scope": ["entity.name.function", "meta.definition.method entity.name.function"],
			"settings": { "foreground": "#a48d43" }
		},
		{
			"name": "Function call",
			"scope": [
				"meta.function-call entity.name.function",
				"meta.function-call.generic",
				"support.function",
				"meta.method-call entity.name.function"
			],
			"settings": { "foreground": "#938042" }
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.interface",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.primitive",
				"storage.type.built-in"
			],
			"settings": { "foreground": "#5e7fb7" }
		},
		{
			"name": "Parameter",
			"scope": ["variable.parameter", "meta.parameter variable"],
			"settings": { "foreground": "#986eb1" }
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property",
				"meta.object-literal.key",
				"support.type.property-name",
				"entity.other.attribute-name"
			],
			"settings": { "foreground": "#4b857e" }
		},
		{
			"name": "Namespace",
			"scope": ["entity.name.namespace", "entity.name.type.namespace", "entity.name.module"],
			"settings": { "foreground": "#857c70" }
		},
		{
			"name": "Decorator",
			"scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.attribute"],
			"settings": { "foreground": "#6e8343" }
		},
		{
			"name": "Tag",
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#5e7fb7" }
		},
		{
			"name": "CSS selectors",
			"scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"],
			"settings": { "foreground": "#a48d43" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#cc505a" }
		},
		{
			"name": "Deprecated",
			"scope": "invalid.deprecated",
			"settings": { "foreground": "#986eb1", "fontStyle": "strikethrough" }
		},
		{
			"name": "Markdown heading",
			"scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
			"settings": { "foreground": "#398d6e", "fontStyle": "bold" }
		},
		{
			"name": "Markdown emphasis",
			"scope": "markup.italic",
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Markdown strong",
			"scope": "markup.bold",
			"settings": { "fontStyle": "bold" }
		},
		{
			"name": "Markdown link",
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#5e7fb7" }
		},
		{
			"name": "Markdown quote",
			"scope": "markup.quote",
			"settings": { "foreground": "#5f5952" }
		},
		{
			"name": "Markdown list marker",
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": { "foreground": "#398d6e" }
		},
		{
			"name": "Diff inserted",
			"scope": "markup.inserted",
			"settings": { "foreground": "#398d6e" }
		},
		{
			"name": "Diff deleted",
			"scope": "markup.deleted",
			"settings": { "foreground": "#b8616f" }
		},
		{
			"name": "Diff changed",
			"scope": "markup.changed",
			"settings": { "foreground": "#b4763f" }
		}
	],
	"semanticTokenColors": {
		"function": "#938042",
		"method": "#938042",
		"function.declaration": "#a48d43",
		"method.declaration": "#a48d43",
		"variable": "#7d756b",
		"parameter": "#986eb1",
		"property": "#4b857e",
		"variable.readonly": "#9a8468",
		"property.readonly": "#9a8468",
		"enumMember": "#b4763f",
		"class": "#5e7fb7",
		"struct": "#5e7fb7",
		"enum": "#5e7fb7",
		"type": "#5e7fb7",
		"interface": "#7389b8",
		"typeParameter": "#7389b8",
		"namespace": "#857c70",
		"decorator": "#6e8343",
		"macro": "#6e8343",
		"*.deprecated": { "strikethrough": true }
	}
}
