	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#3c4641"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#5b6761"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.word",
				"keyword.operator.logical.python",
				"variable.language"
			],
			"settings": {
				"foreground": "#458e72"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"punctuation.definition.string",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#9e7b44"
			}
		},
		{
			"name": "String escape and regex",
			"scope": [
				"constant.character.escape",
				"string.regexp",
				"constant.other.placeholder"
			],
			"settings": {
				"foreground": "#a36584"
			}
		},
		{
			"name": "Number and constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"support.constant",
				"keyword.other.unit",
				"constant.other.color"
			],
			"settings": {
				"foreground": "#8e854c"
			}
		},
		{
			"name": "Function declaration",
			"scope": [
				"entity.name.function",
				"meta.definition.method entity.name.function"
			],
			"settings": {
				"foreground": "#5d9b83"
			}
		},
		{
			"name": "Function call",
			"scope": [
				"meta.function-call entity.name.function",
				"meta.function-call.generic",
				"support.function",
				"meta.method-call entity.name.function"
			],
			"settings": {
				"foreground": "#60897b"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.enum",
				"entity.name.interface",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.primitive",
				"storage.type.built-in"
			],
			"settings": {
				"foreground": "#518691"
			}
		},
		{
			"name": "Parameter",
			"scope": [
				"variable.parameter",
				"meta.parameter variable"
			],
			"settings": {
				"foreground": "#7b73a5"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property",
				"meta.object-literal.key",
				"support.type.property-name",
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#668357"
			}
		},
		{
			"name": "Namespace",
			"scope": [
				"entity.name.namespace",
				"entity.name.type.namespace",
				"entity.name.module"
			],
			"settings": {
				"foreground": "#718079"
			}
		},
		{
			"name": "Decorator",
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.decorator",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#a36584"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#518691"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.other.attribute-name.pseudo-class.css"
			],
			"settings": {
				"foreground": "#5d9b83"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#b45959"
			}
		},
		{
			"name": "Deprecated",
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#7b73a5",
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Markdown heading",
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#458e72",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown strong",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown link",
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#518691"
			}
		},
		{
			"name": "Markdown quote",
			"scope": "markup.quote",
			"settings": {
				"foreground": "#515c57"
			}
		},
		{
			"name": "Markdown list marker",
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": {
				"foreground": "#458e72"
			}
		},
		{
			"name": "Diff inserted",
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#458e72"
			}
		},
		{
			"name": "Diff deleted",
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#b45959"
			}
		},
		{
			"name": "Diff changed",
			"scope": "markup.changed",
			"settings": {
				"foreground": "#9e7b44"
			}
		},
